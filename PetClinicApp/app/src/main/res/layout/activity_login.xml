<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app2="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/teal_background"
    android:fillViewport="true"
    tools:context=".LoginActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="32dp">

        <!-- Icono de Perfil Grande -->

        <androidx.cardview.widget.CardView
            android:id="@+id/cv_profile_avatar"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginTop="48dp"
            app2:cardCornerRadius="75dp"
            app2:cardBackgroundColor="@color/white"
            app2:cardElevation="0dp"
            app2:layout_constraintTop_toTopOf="parent"
            app2:layout_constraintStart_toStartOf="parent"
            app2:layout_constraintEnd_toEndOf="parent">

            <!-- El icono de persona centrado dentro del círculo blanco -->
            <ImageView
                android:id="@+id/iv_person_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:padding="30dp"
                android:src="@drawable/ic_person_login"
                app2:tint="@color/teal_background" /> <!-- Tint de color de fondo para contraste -->

        </androidx.cardview.widget.CardView>

        <!-- Campo de Usuario -->
        <EditText
            android:id="@+id/etUser"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_marginTop="48dp"
            android:background="@drawable/rounded_edittext_outline"
            android:hint="@string/msg_username"
            android:inputType="textPersonName"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:textColor="@color/white"
            android:textColorHint="@color/gray_text"
            android:textSize="18sp"
            app2:layout_constraintTop_toBottomOf="@+id/cv_profile_avatar"
            app2:layout_constraintStart_toStartOf="parent"
            app2:layout_constraintEnd_toEndOf="parent"/>

        <!-- Campo de Contraseña -->
        <EditText
            android:id="@+id/etPassword"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/rounded_edittext_outline"
            android:hint="@string/msg_password"
            android:inputType="textPassword"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:textColor="@color/white"
            android:textColorHint="@color/gray_text"
            android:textSize="18sp"
            app2:layout_constraintEnd_toEndOf="parent"
            app2:layout_constraintStart_toStartOf="parent"
            app2:layout_constraintTop_toBottomOf="@+id/etUser" />

        <!-- Botón de Login -->
        <Button
            android:id="@+id/btn_login"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_marginTop="32dp"
            android:backgroundTint="@color/white"
            android:background="@drawable/rounded_button_background"
            android:text="@string/btn_login"
            android:textAllCaps="false"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold"
            app2:layout_constraintEnd_toEndOf="parent"
            app2:layout_constraintStart_toStartOf="parent"
            app2:layout_constraintTop_toBottomOf="@+id/etPassword" />

        <!-- Texto "Social Login" -->
        <TextView
            android:id="@+id/tv_social_login_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/msg_login_alternatives"
            android:textColor="@color/white"
            android:textSize="16sp"
            app2:layout_constraintTop_toBottomOf="@id/btn_login"
            app2:layout_constraintEnd_toEndOf="parent"
            app2:layout_constraintStart_toStartOf="parent"/>

        <!-- Contenedor de Iconos Sociales -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            app2:layout_constraintEnd_toEndOf="parent"
            app2:layout_constraintStart_toStartOf="parent"
            app2:layout_constraintTop_toBottomOf="@+id/tv_social_login_label">

            <ImageView
                android:id="@+id/iv_social_fb"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginEnd="16dp"
                android:src="@drawable/ic_person"
                app2:tint="@color/fb_blue" />

            <ImageView
                android:id="@+id/iv_social_insta"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginEnd="16dp"
                android:src="@drawable/ic_person" />

            <ImageView
                android:id="@+id/iv_social_linkedin"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/ic_person"
                app2:tint="@color/linkedin_blue" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>